# syntax=docker/dockerfile:1.7

# Backend-only image for frontend development. The placeholder dist directory
# satisfies the //go:embed directive while the frontend runs from Bun locally.
FROM --platform=$BUILDPLATFORM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS go-builder

ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOWORK=off \
    GOEXPERIMENT=greenteagc

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG GOAMD64
ENV GOOS=${TARGETOS} \
    GOARCH=${TARGETARCH} \
    GOAMD64=${GOAMD64}

WORKDIR /build

COPY go.mod go.sum ./
COPY relaykit/go.mod relaykit/go.sum ./relaykit/
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN mkdir -p web/dist && \
    printf '%s\n' '<!doctype html><html><head><title>dev</title></head><body>use frontend dev server</body></html>' > web/dist/index.html

RUN --mount=type=cache,target=/root/.cache/go-build \
    version="$(cat VERSION)" && \
    go build \
      -trimpath \
      -buildvcs=false \
      -tags netgo,osusergo \
      -ldflags="-s -w -X github.com/QuantumNous/new-api/common.Version=${version}" \
      -o /out/new-api .

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS runtime

RUN apk add --no-cache ca-certificates tzdata

COPY --from=go-builder /out/new-api /new-api
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
STOPSIGNAL SIGTERM
ENTRYPOINT ["/new-api"]
